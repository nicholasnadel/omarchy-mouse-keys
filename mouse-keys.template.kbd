;; Generated device list is filled in by install.py.
;; Hold D briefly for pointer actions; release it to type normally.
(defcfg
  process-unmapped-keys no
  linux-dev-names-include (
@DEVICE_NAMES@
  )
)

(defsrc
  rmet d m h j k l v b n s f g
  a c e i o p q r t u w x y z
  1 2 3 4 5 6 7 8 9 0
  spc tab ret bspc esc lsft rsft lctl rctl lalt ralt
)

(defalias
  d-mouse (tap-hold 250 250 d (layer-while-held dmouse))
  left  (movemouse-accel-left 10 350 1 13)
  down  (movemouse-accel-down 10 350 1 13)
  up    (movemouse-accel-up 10 350 1 13)
  right (movemouse-accel-right 10 350 1 13)
  scroll-left  (mwheel-left 90 120)
  scroll-down  (mwheel-down 90 120)
  scroll-up    (mwheel-up 90 120)
  scroll-right (mwheel-right 90 120)
)

(deflayer base
  _ @d-mouse _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _
)

;; S is a held no-op trigger, so releasing D cannot leave a scroll layer active.
(deflayer dmouse
  _ XX _ (fork @left @scroll-left (nop0)) (fork @down @scroll-down (nop0))
  (fork @up @scroll-up (nop0)) (fork @right @scroll-right (nop0)) mlft mrgt mmid
  nop0 (movemouse-speed 380) (movemouse-speed 50)
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _
)
